# PlaySphere Backend Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI or leave default for auto in-memory fallback)
MONGO_URI=mongodb://127.0.0.1:27017/playsphere

# JWT Authentication Secrets (High Entropy 256-bit Random Strings)
JWT_SECRET=your_super_secret_jwt_access_key_replace_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_replace_in_production

# Frontend Client URL
FRONTEND_URL=http://localhost:5173

# Admin UPI Payment ID (for QR Code Booking Simulation)
UPI_ADMIN_ID=merchant_id@okhdfcbank

# Email Verification (Nodemailer)
# Note: Use a Gmail account with an App Password (not your regular password) - enable 2FA on Gmail first, then generate an App Password under Google Account > Security > App Passwords
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_digit_gmail_app_password

# Optional: Google Maps & Places API Keys
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Optional: LLM API Key (OpenAI / Gemini compatible for AI Rules Chatbot)
GEMINI_API_KEY=

# Optional: n8n Automation Webhook URL (Fired on booking, team invite, match live, chatbot escalation)
N8N_WEBHOOK_URL=
